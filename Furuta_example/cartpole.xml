<mujoco model="cartpole">
  <compiler coordinate="local" angle="radian"/>
  <option timestep="0.01" integrator="RK4"/>
  
  <default>
    <geom rgba="0.45 0.6 0.8 1"/>
  </default>
  
  <worldbody>
    <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1"/>
    
    <body name="cart" pos="0 0 0">
      <joint name="slider" type="slide" axis="1 0 0" range="-2.5 2.5" limited="true" damping="0.5"/>
      <geom name="cart" type="box" size="0.2 0.15 0.1" mass="1.0"/>
      
      <body name="pole" pos="0 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom name="pole" type="capsule" fromto="0 0 0 0 0 0.6" size="0.03" mass="0.1"/>
      </body>
    </body>
  </worldbody>
  
  <actuator>
    <motor name="slide_motor" joint="slider" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
